ackages (from python-dateutil>=2.7->matplotlib) (1.17.0)\n"]}],"source":["pip install numpy matplotlib sympy"]},{"cell_type":"code","source":["import numpy as np\n","import matplotlib.pyplot as plt\n","import sympy as sp\n","\n","# ==========================================\n","# 1. 수식 파서(Parser): 수식 입력 및 해석\n","# ==========================================\n","\n","x = sp.symbols('x')\n","\n","# 사용자가 입력한 함수\n","f_expr = sp.sympify(\"x**2\")\n","g_expr = sp.sympify(\"2*x\")\n","\n","# 컴퓨터가 계산할 수 있는 함수로 변환\n","f = sp.lambdify(x, f_expr, \"numpy\")\n","g = sp.lambdify(x, g_expr, \"numpy\")\n","\n","print(\"함수 f(x):\", f_expr)\n","print(\"함수 g(x):\", g_expr)\n","\n","\n","# ==========================================\n","# 2. 샘플링: 좌표 생성 및 그래프 표현\n","# ==========================================\n","\n","x_points = np.linspace(-2, 4, 100)\n","\n","y_points = f(x_points)\n","\n","# 샘플링된 좌표 출력\n","print(\"\\n[샘플링 좌표]\")\n","for i in range(0, len(x_points), 20):\n","    print(\n","        f\"x={x_points[i]:.2f}, \"\n","        f\"y={y_points[i]:.2f}\"\n","    )\n","\n","\n","# ==========================================\n","# 3. 미분: 중앙 차분법\n","# ==========================================\n","\n","def numerical_derivative(func, x_value, h=0.0001):\n","    return (\n","        func(x_value + h) - func(x_value - h)\n","    ) / (2 * h)\n","\n","\n","target_x = 2\n","\n","slope = numerical_derivative(f, target_x)\n","\n","print(\"\\n[미분 결과]\")\n","print(\"x =\", target_x)\n","print(\"접선의 기울기 =\", slope)\n","\n","\n","# ==========================================\n","# 4. 적분: 사다리꼴 공식\n","# ==========================================\n","\n","def numerical_integral(func, a, b, n=1000):\n","    xs = np.linspace(a, b, n + 1)\n","    ys = func(xs)\n","\n","    h = (b - a) / n\n","\n","    area = h * (\n","        np.sum(ys) - (ys[0] + ys[-1]) / 2\n","    )\n","\n","    return area\n","\n","\n","area = numerical_integral(f, 0, 2)\n","\n","print(\"\\n[적분 결과]\")\n","print(\"적분 구간: 0 ~ 2\")\n","print(\"넓이의 근삿값 =\", area)\n","\n","\n","# ==========================================\n","# 5. 교점 계산: 이분법\n","# ==========================================\n","\n","def bisection(func, a, b, tolerance=1e-8):\n","    if func(a) * func(b) > 0:\n","        raise ValueError(\"구간 양 끝의 함수값 부호가 달라야 합니다.\")\n","\n","    while abs(b - a) > tolerance:\n","        mid = (a + b) / 2\n","\n","        if abs(func(mid)) < tolerance:\n","            return mid\n","\n","        if func(a) * func(mid) < 0:\n","            b = mid\n","        else:\n","            a = mid\n","\n","    return (a + b) / 2\n","\n","\n","# 두 함수의 차이가 0이 되는 지점 탐색\n","def difference(t):\n","    return f(t) - g(t)\n","\n","\n","root1 = bisection(difference, -1, 1)\n","root2 = bisection(difference, 1, 3)\n","\n","print(\"\\n[교점 계산 결과]\")\n","print(\"첫 번째 교점:\", root1, f(root1))\n","print(\"두 번째 교점:\", root2, f(root2))\n","\n","\n","# ==========================================\n","# 6. 그래프 시각화\n","# ==========================================\n","\n","xs = np.linspace(-2, 4, 500)\n","\n","plt.figure(figsize=(10, 7))\n","\n","# 두 함수 그래프\n","plt.plot(xs, f(xs), label=\"f(x) = x^2\")\n","plt.plot(xs, g(xs), label=\"g(x) = 2x\")\n","\n","# 샘플링된 점 연결\n","sample_x = np.linspace(-2, 4, 13)\n","plt.plot(\n","    sample_x,\n","    f(sample_x),\n","    \"o--\",\n","    label=\"Sampled points\"\n",")\n","\n","# 적분 영역 표시\n","area_x = np.linspace(0, 2, 100)\n","plt.fill_between(\n","    area_x,\n","    f(area_x),\n","    0,\n","    alpha=0.2,\n","    label=\"Integral area\"\n",")\n","\n","# 접선 표시\n","tangent_y = slope * (xs - target_x) + f(target_x)\n","plt.plot(xs, tangent_y, \"--\", label=\"Tangent at x=2\")\n","\n","# 교점 표시\n","plt.scatter(\n","    [root1, root2],\n","    [f(root1), f(root2)],\n","    color=\"red\",\n","    s=70,\n","    label=\"Intersections\",\n","    zorder=5\n",")\n","\n","plt.axhline(0, color=\"black\", linewidth=0.7)\n","plt.axvline(0, color=\"black\", linewidth=0.7)\n","\n","plt.xlabel(\"x\")\n","plt.ylabel(\"y\")\n","plt.title(\"Calculus Simulation using Python\")\n","\n","plt.grid(True)\n","plt.legend()\n","plt.show()\n"],"metadata":{"id":"cYFmHTevAP64","colab":{"base_uri":"https://localhost:8080/","height":1000},"executionInfo":{"status":"ok","timestamp":1793848478139,"user_tz":-540,"elapsed":6863,"user":{"displayName":"키득키득","userId":"05344525294058514628"}},"outputId":"b141834d-5987-4c62-c193-163fd8392187"},"execution_count":2,"outputs":[{"output_type":"stream","name":"stdout","text":["함수 f(x): x**2\n","함수 g(x): 2*x\n","\n","[샘플링 좌표]\n","x=-2.00, y=4.00\n","x=-0.79, y=0.62\n","x=0.42, y=0.18\n","x=1.64, y=2.68\n","x=2.85, y=8.11\n","\n","[미분 결과]\n","x = 2\n","접선의 기울기 = 4.000000000004\n","\n","[적분 결과]\n","적분 구간: 0 ~ 2\n","넓이의 근삿값 = 2.666668\n","\n","[교점 계산 결과]\n","첫 번째 교점: 0.0 0.0\n","두 번째 교점: 2.0 4.0\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x700 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":[],"metadata":{"id":"6NgvzVpXs23p"},"execution_count":null,"outputs":[]}]}